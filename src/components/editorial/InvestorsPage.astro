---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Hero from './Hero.astro';
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';
import { copy, photograph } from '../../data/editorial/content';
import { site } from '../../data/site';
const logo=photograph('logo-apollo.jpg');
---
<EditorialLayout slug="inversionistas" title="Inversionistas" description={copy('inversionistas','Nuestros inversionistas')}>
  <Hero number="04" label="INVERSIONISTAS" title="" accent="Inversionistas" wide intro={copy('inversionistas','Nuestros inversionistas')} photo="fondo-inversionistas.jpg"/>
  <section class="ed-section"><div class="wrap"><SectionHead number="01" title="SOCIOS ESTRATÉGICOS"/><div class="ed-statement"><h2 data-editorial-reveal>De Alto<br/><em>Calibre</em></h2><p data-editorial-reveal>{copy('inversionistas','Altum ha formado')}</p></div></div></section>
  <section class="ed-testimonial"><div class="wrap"><SectionHead number="02" title="APOLLO INVESTMENT CORPORATION"/><div class="ed-quote-layout"><div data-editorial-reveal><img src={logo.local} data-source-src={logo.source} width="200" height="90" alt="Apollo Investment Corporation"/></div><blockquote data-editorial-reveal><p>{copy('inversionistas','"Hemos decidido')}</p><cite>Apollo Investment Corporation</cite></blockquote></div></div></section>
  <section class="ed-section"><div class="wrap"><SectionHead number="03" title="ALTUM CAPITAL"/><div class="ed-investor-history"><div data-editorial-reveal><h2>¿Por qué invertir<br/><em>en Altum Capital?</em></h2><p class="ed-body">{copy('inversionistas','Desde su fundación')}</p><a class="ed-link" href={site.investorUrl} target="_blank" rel="noopener noreferrer">Información para inversionistas <span aria-hidden="true">↗</span></a></div><div class="ed-diptych ed-investor-images" data-editorial-reveal><Photo name="inversionistas-1.jpg"/><Photo name="inversionistas-2.jpg"/></div></div></div></section>
</EditorialLayout>
