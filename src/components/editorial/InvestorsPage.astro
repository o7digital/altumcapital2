---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Hero from './Hero.astro';
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';
import Milestones from './Milestones.astro';
import { copy, photograph } from '../../data/editorial/content';
import { site } from '../../data/site';
const logo=photograph('logo-apollo.jpg');
---
<EditorialLayout slug="inversionistas" title="Inversionistas" description={copy('inversionistas','Nuestros inversionistas')}>
  <Hero number="04" label="INVERSIONISTAS" title="" accent="Inversionistas" wide intro={copy('inversionistas','Nuestros inversionistas')} photo="fondo-inversionistas.jpg"><p class="ed-hero-detail">{copy('inversionistas','Altum ha formado')}</p></Hero>
  <nav class="ed-page-index wrap" aria-label="En esta página"><span>INVERSIONISTAS</span><a href="#socios">Socios estratégicos ↓</a><a href="#apollo">Apollo ↓</a><a href="#trayectoria">Publicaciones ↓</a></nav>
  <section class="ed-section" id="socios"><div class="wrap"><SectionHead number="01" title="SOCIOS ESTRATÉGICOS"/><div class="ed-feature"><div class="ed-feature-copy"><h2>De Alto<br/><em>Calibre</em></h2><h3 class="ed-subheading">¿Por qué invertir en Altum Capital?</h3><p class="ed-body">{copy('inversionistas','Desde su fundación')}</p><p class="ed-body">{site.description}</p><a class="ed-link" href={site.investorUrl} target="_blank" rel="noopener noreferrer">Información para inversionistas <span aria-hidden="true">↗</span></a></div><div class="ed-compact-diptych"><Photo name="inversionistas-1.jpg"/><Photo name="inversionistas-2.jpg"/></div></div></div></section>
  <section class="ed-testimonial" id="apollo"><div class="wrap"><SectionHead number="02" title="APOLLO INVESTMENT CORPORATION"/><div class="ed-quote-layout"><div><img src={logo.local} data-source-src={logo.source} width="200" height="90" alt="Apollo Investment Corporation"/></div><blockquote><p>{copy('inversionistas','"Hemos decidido')}</p><cite>Apollo Investment Corporation</cite></blockquote></div></div></section>
  <section class="ed-section" id="trayectoria"><div class="wrap"><SectionHead number="03" title="PUBLICACIONES DE ALTUM CAPITAL"/><div class="ed-feature ed-feature--principles"><div><h2>Participación en<br/><em>el mercado de capitales</em></h2><p class="ed-body">Operaciones e hitos publicados por la firma. Los montos corresponden a las fechas de cada publicación.</p><a class="ed-link" href="/blog/">Todas las noticias <span aria-hidden="true">↗</span></a></div><Milestones years={['2019 / 2022','2024','2025']}/></div></div></section>
</EditorialLayout>
