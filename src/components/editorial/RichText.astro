---
import type { RichBlock } from '../../data/editorial/types';
interface Props { blocks: RichBlock[]; }
const { blocks } = Astro.props;
---
<div class="ed-prose">{blocks.map(block => {
  if(block.kind==='heading')return <h3 set:html={block.html}/>;
  if(block.kind==='quote')return <blockquote set:html={block.html}/>;
  if(block.kind==='list')return block.ordered?<ol>{block.items?.map(item=><li set:html={item.html}/>)}</ol>:<ul>{block.items?.map(item=><li set:html={item.html}/>)}</ul>;
  return <p set:html={block.html}/>;
})}</div>
