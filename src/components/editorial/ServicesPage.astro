---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Hero from './Hero.astro';
import SectionHead from './SectionHead.astro';
import Principles from './Principles.astro';
import { about, copy } from '../../data/editorial/content';
import { creditUses } from '../../data/editorial/narrative';
---
<EditorialLayout slug="soluciones-de-credito" title="Soluciones de crédito" description={copy('soluciones-de-credito','Créditos a la medida')}>
  <Hero number="02" label="SOLUCIONES DE CRÉDITO" title="Soluciones" accent="de crédito" intro={copy('soluciones-de-credito','Créditos a la medida')} photo="cabezal-soluciones.jpg"><p class="ed-hero-detail">{about.activity}</p></Hero>
  <nav class="ed-page-index wrap" aria-label="En esta página"><span>SOLUCIONES DE CRÉDITO</span><a href="#soluciones">Usos del crédito ↓</a><a href="#monedas">Pesos y dólares ↓</a><a href="#socio">Nuestra forma de trabajar ↓</a></nav>
  <section class="ed-section" id="soluciones"><div class="wrap"><SectionHead number="01" title="NUESTRAS SOLUCIONES"/><div class="ed-statement"><h2>Nuestras<br/><em>Soluciones</em></h2><p>{copy('soluciones-de-credito','Ofrecemos créditos')}</p></div><ol class="ed-uses">{creditUses.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p class="ed-use-description">{item.description}</p></div></li>)}</ol></div></section>
  <section class="ed-currency-section" id="monedas"><div class="wrap"><SectionHead number="02" title="ALTUM CAPITAL" note="MXN / USD"/><div class="ed-currency-layout"><article><span class="ed-small">01 / MXN</span><h2>Altum Capital<br/><em>Pesos</em></h2><p>{copy('soluciones-de-credito','Enfoque de inversión en deuda privada en pesos')}</p><span class="ed-currency-word" aria-hidden="true">MXN</span></article><article><span class="ed-small">02 / USD</span><h2>Altum Capital<br/><em>Dólares</em></h2><p>{copy('soluciones-de-credito','Enfoque de inversión en deuda privada en dólares')}</p><span class="ed-currency-word" aria-hidden="true">USD</span></article></div></div></section>
  <section class="ed-section" id="socio"><div class="wrap"><SectionHead number="03" title="SOMOS UN"/><div class="ed-feature ed-feature--principles"><div class="ed-feature-copy"><h2>Socio Estratégico<br/><em>para tu empresa</em></h2><p class="ed-body">Nuestros factores diferenciadores son</p><p class="ed-body">{copy('','Con proceso ágil')}</p><a class="ed-link" href="/contact/">Conversemos sobre tu empresa <span aria-hidden="true">↗</span></a></div><Principles items={about.principles}/></div></div></section>
</EditorialLayout>
