---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Hero from './Hero.astro';
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';
import RichText from './RichText.astro';
import entries from '../../data/editorial/prose.json';
import type {RichBlock} from '../../data/editorial/types';
import { about, copy } from '../../data/editorial/content';
import { milestones } from '../../data/editorial/narrative';
const anniversary=entries.find(entry=>entry.slug==='altum-capital-decimo-aniversario')!;
const perspective=anniversary.blocks.find(block=>block.kind==='quote') as RichBlock;
---
<EditorialLayout slug="equipo" title="Equipo" description={copy('equipo','Equipo especializado')}>
  <Hero number="03" label="EQUIPO" title="Nuestro" accent="Equipo" intro={copy('equipo','Equipo especializado')} photo="BG-equipo.jpg"><p class="ed-hero-detail">{copy('equipo','Altum Capital cuenta')}</p></Hero>
  <section class="ed-section"><div class="wrap"><SectionHead number="01" title="NUESTRO EQUIPO"/>
    <div class="ed-feature"><div class="ed-feature-copy"><h2>Experiencia y<br/><em>capital humano</em></h2><p class="ed-body">{copy('equipo','Nuestro Capital Humano')}</p><dl class="ed-inline-statistics"><div><dd>+40</dd><dt>Personas</dt></div><div><dd>+180</dd><dt>Años de experiencia acumulada en el sector financiero</dt></div></dl><p class="ed-body">{milestones[0].text}</p><a class="ed-link" href={`/${milestones[0].slug}/`}>La historia de Altum Capital <span aria-hidden="true">↗</span></a></div><div class="ed-compact-diptych"><Photo name="crop-coworkers-with-papers-in-office-2023-04-12-00-56-14-utc-scaled.jpeg"/><Photo name="sobre-altum-capital-objetivo.jpg"/></div></div>
  </div></section>
  <section class="ed-section ed-difference"><div class="wrap"><SectionHead number="02" title="NUESTRO"/><div class="ed-feature"><Photo name="group-of-coworkers-working-on-project-together-in-2023-06-13-23-00-36-utc-scaled.jpg" class="ed-team-photo"/><div><h2>Un equipo,<br/><em>una misma visión</em></h2><p class="ed-body">{about.objective}</p><div class="ed-team-priorities"><div><h3>Clientes</h3><p>{about.activity}</p><a class="ed-link" href="/soluciones-de-credito/">Soluciones de crédito <span aria-hidden="true">↗</span></a></div><div><h3>Inversionistas</h3><p>{copy('inversionistas','Altum ha formado')}</p><a class="ed-link" href="/inversionistas/">Conoce más <span aria-hidden="true">↗</span></a></div></div></div></div><div class="ed-team-quote"><span class="ed-small">LA PERSPECTIVA DEL EQUIPO</span><RichText blocks={[perspective]}/><a class="ed-link" href={`/${anniversary.slug}/`}>Publicación del 29 de agosto de 2024 <span aria-hidden="true">↗</span></a></div></div></section>
</EditorialLayout>
