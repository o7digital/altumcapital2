---
import SiteLayout from '../layouts/SiteLayout.astro';
import CreditExplorer from '../components/CreditExplorer';
import ContactDetails from '../components/ContactDetails.astro';
import TeamContent from '../components/TeamContent.astro';
import NewsList from '../components/NewsList.astro';
import content from '../data/imported.json';
import { differentiators, site, uses } from '../data/site';
---
<SiteLayout>
  <main id="main">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <div class="hero-fallback"><i></i><i></i><i></i><i></i><i></i></div>
        <img src="/images/hero.jpg" width="2400" height="1600" alt="" fetchpriority="high" decoding="async" />
      </div>
      <div class="hero-shade"></div>
      <div class="hero-gridlines" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="hero-content wrap">
        <div class="hero-kicker"><span class="eyebrow"><span class="status-dot"></span> FINANCIAMIENTO EN MXN Y USD.</span><span class="hero-edition">MÉXICO<br />LATINOAMÉRICA</span></div>
        <h1 id="hero-title">Soluciones de<br /><em>financiamiento.</em></h1>
        <div class="hero-bottom-content">
          <div class="hero-actions"><a class="button button-light" href="#soluciones">Soluciones de crédito <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#inversionistas">Soy inversionista <span aria-hidden="true">↗</span></a></div>
          <p class="hero-description">De 75M – 500M (MXN)<br /><span>Pymes, Instituciones Financieras no Bancarias y Fondos de Capital Privado.</span></p>
        </div>
      </div>
      <div class="hero-foot wrap"><a href="#firma" class="scroll-link"><span aria-hidden="true">↓</span> DESCUBRE ALTUM</a><div class="hero-coordinate"><span class="line"></span> UNA PERSPECTIVA DIFERENTE</div><span class="hero-page">01 <span>/</span> 07</span></div>
    </section>

    <section class="credentials" aria-label="Cifras de Altum">
      <div class="wrap credentials-grid">
        <div class="credential"><span class="eyebrow">UNA VISIÓN QUE EVOLUCIONA</span><strong>2014<span>→</span></strong><p>El inicio de nuestra trayectoria.</p></div>
        <div class="credential"><span class="eyebrow">EXPERIENCIA EN DEUDA PRIVADA</span><strong>06<span>fondos</span></strong><p>Una plataforma especializada.</p></div>
        <div class="credential"><span class="eyebrow">CAPITAL QUE SE CONVIERTE EN ACCIÓN</span><strong>450<span>+</span></strong><p>Créditos originados.</p></div>
        <a class="credential credential-link" href="#firma"><span class="eyebrow">MÁS QUE CIFRAS.</span><span class="credential-statement">Una visión<br /><em>compartida.</em></span><span class="round-arrow" aria-hidden="true">↗</span></a>
      </div><div class="wrap data-note">Cifras publicadas en el sitio de origen de Altum Capital.</div>
    </section>

    <section class="manifesto section-pad" id="firma" aria-labelledby="firm-title">
      <div class="wrap">
        <div class="section-top"><span class="section-label"><span>01 /</span> LA FIRMA</span><span class="eyebrow">INDEPENDENCIA DE PENSAMIENTO</span></div>
        <div class="manifesto-heading"><h2 id="firm-title">Lo que hacemos.<br /><em>Crédito a la medida.</em></h2><span class="big-star" aria-hidden="true">✳</span></div>
        <div class="manifesto-grid">
          <figure class="firm-image"><div class="image-fallback"><svg viewBox="0 0 620 620" aria-hidden="true"><path d="M0 460 280 145 620 320 620 620 0 620Z" fill="#a5aaa2"/><path d="M280 145 283 620 0 620 0 460Z" fill="#d7d7cd"/><path d="M280 145 620 320 283 620Z" fill="#c3c6bc"/><path d="M280 145 490 400 620 320M80 372 283 620M158 285 356 558M225 210 428 491" fill="none" stroke="#8a9389" stroke-width="1"/></svg></div><img src="/images/firm.jpg" width="1200" height="1300" alt="Arquitectura contemporánea de líneas geométricas. Imagen conceptual, no representa un activo de Altum." loading="lazy" decoding="async"/><figcaption><span>ARQUITECTURA DE UNA VISIÓN</span><span>01 — PERSPECTIVA</span></figcaption></figure>
          <div class="manifesto-copy"><span class="eyebrow">NUESTRO OBJETIVO</span><h3>Deuda privada.<br /><em>Servicio personalizado.</em></h3><p>{site.description}</p><p>{site.objective}</p><a class="text-link" href="/about/">Conoce nuestra firma <span aria-hidden="true">↗</span></a><div class="firm-signature"><svg viewBox="0 0 42 40" aria-hidden="true"><path d="M3 34 21 4l18 30M12 21h18M10 34l11-18 11 18"/></svg><span>Procesos claros y expeditos.<br />Relaciones a largo plazo.</span></div></div>
        </div>
      </div>
    </section>

    <section class="solutions section-pad" id="soluciones" aria-labelledby="solutions-title">
      <div class="wrap"><div class="section-top"><span class="section-label"><span>02 /</span> FINANCIAMIENTO</span><span class="eyebrow">DOS MONEDAS. UNA MISMA VISIÓN.</span></div><div class="solutions-heading"><h2 id="solutions-title">Créditos a la medida.<br /><em>Tus necesidades.</em></h2><p>Acelera el crecimiento de tu empresa con nuestras soluciones de financiamiento en pesos y dólares.</p></div>
        <CreditExplorer client:load />
        <div class="uses"><span class="eyebrow">CAPITAL PARA</span><p>{uses.map((use, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{use}</>)}</p></div><a class="text-link all-solutions" href="/soluciones-de-credito/">Nuestras soluciones <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="investors" id="inversionistas" aria-labelledby="investors-title">
      <div class="investor-landscape" aria-hidden="true"><img src="/images/investors.jpg" width="1600" height="1100" alt="" loading="lazy" decoding="async"/></div>
      <div class="wrap investor-wrap"><div class="section-top"><span class="section-label"><span>03 /</span> INVERSIONISTAS</span><span class="eyebrow">VISIÓN COMPARTIDA</span></div>
        <div class="investor-layout"><div><h2 id="investors-title">Socios<br />estratégicos.<br /><em>De alto calibre.</em></h2><p>{site.partnersIntro}</p><a class="button button-outline" href="#contacto" data-inquiry="inversion">Información para inversionistas <span aria-hidden="true">↗</span></a><a class="investor-more" href="/inversionistas/">Conoce más <span aria-hidden="true">↗</span></a></div><div class="investor-partner"><span class="eyebrow">NUESTROS INVERSIONISTAS</span><img src={content.apolloImage} width="200" height="90" alt="Apollo Investment Corporation" loading="lazy"/><blockquote>{site.apolloQuote}<cite>Apollo Investment Corporation</cite></blockquote></div></div>
      </div>
      <div class="investor-word" aria-hidden="true">PERSPECTIVA</div>
    </section>

    <section class="approach section-pad" id="enfoque" aria-labelledby="approach-title"><div class="wrap"><div class="section-top"><span class="section-label"><span>04 /</span> NUESTROS DIFERENCIADORES</span><span class="eyebrow">UN SOCIO ESTRATÉGICO</span></div><div class="approach-grid"><div class="approach-intro"><h2 id="approach-title">Créditos flexibles.<br /><em>A la medida.</em></h2><p>Con proceso ágil, soluciones a la medida y garantías no tradicionales, como flujos y cuentas por cobrar.</p><a class="text-link" href="/soluciones-de-credito/">Nuestras soluciones <span aria-hidden="true">↗</span></a></div><div class="approach-rows">{differentiators.map((item, index) => <details open={index === 0}><summary><span>0{index + 1}</span><h3>{item.title}</h3><i aria-hidden="true"/></summary><div class="detail-body"><p>{item.copy}</p></div></details>)}</div></div></div></section>
    <section class="team-section section-pad" id="equipo" aria-labelledby="team-label"><div class="wrap"><div class="section-top"><span class="section-label" id="team-label"><span>05 /</span> NUESTRO EQUIPO</span><span class="eyebrow">EXPERIENCIA EN DEUDA</span></div><TeamContent /><a class="text-link" href="/equipo/">Conoce nuestro equipo <span aria-hidden="true">↗</span></a></div></section>
    <section class="news-section section-pad" id="noticias" aria-labelledby="news-title"><div class="wrap"><div class="section-top"><span class="section-label"><span>06 /</span> NOTICIAS</span><span class="eyebrow">ALTUM EN LOS MEDIOS</span></div><div class="news-heading"><h2 id="news-title">Noticias.<br/><em>Lo que sigue.</em></h2><p>Conoce acerca de nuestra presencia y de la de nuestros clientes en los medios.</p></div><NewsList limit={3}/><a class="text-link" href="/blog/">Todas las noticias <span aria-hidden="true">↗</span></a></div></section>
    <section class="contact-section" id="contacto" aria-labelledby="contact-title"><div class="wrap"><div class="section-top"><span class="section-label"><span>07 /</span> CONTÁCTANOS</span><span class="eyebrow">PARA MÁS INFORMACIÓN</span></div><a class="contact-invitation" href="mailto:contacto@altumcapital.com.mx" data-inquiry="financiamiento"><h2 id="contact-title">Potencialicemos<br /><em>tu empresa.</em></h2><span class="contact-arrow" aria-hidden="true">↗</span></a><div class="contact-baseline"><p>Te dejamos nuestros datos de contacto.</p><span>EMPRESAS / INVERSIONISTAS</span></div><ContactDetails /><aside class="institutional-notice"><span class="eyebrow">AVISO IMPORTANTE</span><p>{site.notice}</p></aside></div></section>
  </main>
</SiteLayout>
